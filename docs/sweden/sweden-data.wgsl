  var x = 0;
  for (var i = SWEDEN_ROW_START[row]; i < end; i++) {
    let w = SWEDEN_RUNS[i];
    x += i32(w >> 9u);
    if (col < x) {
      return w & 0x1ffu;
    }
  }
  return 0u;
}
